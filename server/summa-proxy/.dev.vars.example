# Copy to .dev.vars for local `wrangler dev`. NEVER commit .dev.vars.
# In production these are set with `wrangler secret put <NAME>` instead.
ANTHROPIC_API_KEY=sk-ant-...
SUMMA_ACCESS_TOKENS=test-local-code
# Sign in with Apple (optional locally):
SUMMA_SESSION_SECRET=
SUMMA_ALLOWED_EMAILS=you@example.com
