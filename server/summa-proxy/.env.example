# Copy to .env for local runs. NEVER commit the real .env.
# On a hosting platform, set these as secrets in the dashboard instead.

# The only place your Anthropic key lives. Server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# --- Auth path 1: shared per-tester access codes (optional if using sign-in) ---
# Comma-separated beta access codes. Give each tester their own so you can
# revoke one without affecting the others. Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SUMMA_ACCESS_TOKENS=code-for-alice,code-for-bob

# --- Auth path 2: Sign in with Apple + email allowlist (optional) ---
# Your app's bundle id, verified as the audience of Apple's identity token.
APPLE_BUNDLE_ID=com.josephruocco.ScreenGlossMVP
# Secret used to sign the app's 30-day session token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUMMA_SESSION_SECRET=
# Comma-separated emails allowed after sign-in. Only these accounts get served.
SUMMA_ALLOWED_EMAILS=you@example.com

# Optional
ANNOTATION_MODEL=claude-sonnet-4-6
PORT=8787
RATE_LIMIT_PER_MIN=40
MAX_TEXT_CHARS=12000
