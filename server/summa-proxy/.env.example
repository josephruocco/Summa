# Copy to .env for local runs. NEVER commit the real .env.
# On a hosting platform, set these as secrets in the dashboard instead.

# The only place your Anthropic key lives. Server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated beta access codes. Give each tester their own so you can
# revoke one without affecting the others. Generate with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SUMMA_ACCESS_TOKENS=code-for-alice,code-for-bob

# Optional
ANNOTATION_MODEL=claude-sonnet-4-6
PORT=8787
RATE_LIMIT_PER_MIN=40
MAX_TEXT_CHARS=12000
